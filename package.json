{
  "name": "dynamic-island",
  "version": "1.0.0",
  "private": true,
  "description": "灵动岛 for Windows 11 — an Apple-accurate Dynamic Island overlay with media, Bluetooth accessory and Do Not Disturb live activities.",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "native:build": "node scripts/build-native.mjs",
    "native:clean": "node scripts/build-native.mjs --clean",
    "brands:sync": "node scripts/fetch-brand-logos.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "app": "npm run native:build && npm run build && electron .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.4.5",
    "electron-vite": "^5.0.0",
    "framer-motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.32.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
